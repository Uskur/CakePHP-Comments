{
    "name": "kareylo/cakephp-comments",
    "description": "A fully customizable Comments plugin for CakePHP 4.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "comments", "polymorphic", "behavior", "helper", "template"],
    "homepage": "https://github.com/Uskur/CakePHP-Comments",
    "license": "MIT",
    "authors": [
        {
            "name": "Corentin Nazé",
            "email": "corentin.naze@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "cakephp/cakephp": "^4.6",
        "cakephp/migrations": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "cakephp/cakephp-codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kareylo\\Comments\\": "src"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p --standard=vendor/cakephp/cakephp-codesniffer/CakePHP ./src ./tests",
        "cs-fix": "phpcbf --colors --standard=vendor/cakephp/cakephp-codesniffer/CakePHP ./src ./tests",
        "test": "phpunit --colors=always"
    }
}
